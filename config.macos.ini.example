[user-account]
;配置账号密码，留空则打开网页后需手动登录
username =
password =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9222

[script-option]
;自动滑块只支持登录页，课中安全验证仍需手动完成
enableAutoCaptcha = False
enableHideWindow = False
showDonateCode = False

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 30
;播放倍速。0 = 不干预(保持播放器当前倍速, 推荐)
;填具体值时会去点播放器的倍速菜单; 菜单里没有的档位只能靠写属性设置,
;那样会被页面看到。实测这个播放器只提供 1.0 / 1.25 / 1.5
limitSpeed = 0
soundOff = True

[course-url]
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
